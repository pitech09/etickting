DJANGO_SECRET_KEY=replace-this-in-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set DATABASE_URL for PostgreSQL. Without it, local development uses SQLite.
DATABASE_URL=
DATABASE_SSL_REQUIRE=false
DATABASE_CONN_MAX_AGE=60
KENA_SUPPORT_EMAIL=kena.support@gmail.com
DEFAULT_FROM_EMAIL=kena.support@gmail.com
# Configure SMTP in production so the public contact form can deliver email.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Uploaded images and proof files use Cloudinary in production. PostgreSQL stores
# metadata and Cloudinary stores the file bytes.
USE_CLOUDINARY_STORAGE=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional S3-compatible fallback for deployments that intentionally do not use Cloudinary.
USE_OBJECT_STORAGE=false
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_CUSTOM_DOMAIN=
OBJECT_STORAGE_QUERYSTRING_AUTH=true
REDIS_URL=redis://localhost:6379/0
# Redis is required for production WebSocket delivery; readiness fails if unavailable.
CSRF_TRUSTED_ORIGINS=
TEXTBEE_API_KEY=7dd5722b-5e28-47f7-8327-3ea69f47
TEXTBEE_DEVICE_ID=6a0c70199b9db0a6fe9afd2f
# Optional override for a TextBee-compatible endpoint.
TEXTBEE_API_URL=https://api.textbee.dev/api/v1/gateway/send-sms
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=5
# JSON maps key IDs to URL-safe base64 Ed25519 private keys held by the deployment secret manager.
TICKETING_SIGNING_KEYS=
# Retired public keys may remain here so old tickets continue to verify during rotation.
TICKETING_VERIFY_KEYS=
TICKETING_CREDENTIAL_ENCRYPTION_KEY=
# Optional only. Blockchain remains a reconciliation record until Web3 credentials are configured.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
